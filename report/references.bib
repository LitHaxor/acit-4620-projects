@inproceedings{abdelsalamSkyFuseNetCrossAttentionSwin2026,
  title = {{{SkyFuseNet}}: {{A Cross-Attention Swin Transformer-Based Model}} for {{PM2}}.5 {{Estimation Using Ground-Level Images}} and {{Air Quality Readings}}},
  shorttitle = {{{SkyFuseNet}}},
  booktitle = {2026 {{Intelligent Methods}}, {{Systems}}, and {{Applications}} ({{IMSA}})},
  author = {Abdelsalam, Mohamed Saleh and Sayed, Gehad Ismail},
  date = {2026-07},
  year = {2026},
  pages = {489--494},
  publisher = {IEEE},
  location = {Giza, Egypt},
  doi = {10.1109/IMSA70415.2026.11700341},
  url = {https://ieeexplore.ieee.org/document/11700341/},
  abstract = {Fine particulate matter ( . ) is one of the most harmful air pollutants, and long-term exposure can lead to cardiovascular and respiratory diseases. The estimation of . concentration using traditional methods is a big challenge, especially for regions where it is an economic burden to deploy large numbers of monitoring stations and sensors. Current image-based estimation methods mostly rely on CNNs, which only capture local features, without using concurrent sensor data, which is also correlated with the concentration of . . In this paper, SkyFuseNet is presented as an efficient multimodal, multitask deep learning model with 49.63 million parameters. The model uses a Swin Transformer, a learnable attention-pooling neck, a multi-layer perceptron for the sensor encoder, and a cross-attention fusion module that employs an intermediate fusion strategy. The model uses a dual-head structure, where information from the later stage passes through a dense layer and is then split into regression and classification tasks. The output is then combined using a weighted loss function. The model was evaluated on the India and Nepal Air Pollution Image Dataset, where the model was able to achieve a test MAE of 3.03 µg/m³, RMSE of 5.70 µg/m³, of 0.9981, MAPE of 3.10\%, and AQI classification accuracy of 91.45\%.},
  eventtitle = {2026 {{Intelligent Methods}}, {{Systems}}, and {{Applications}} ({{IMSA}})},
  isbn = {979-8-3315-8488-7},
  langid = {english},
}

@inproceedings{bylerLocationGeneralizabilityImageBased2025,
  title = {Location {{Generalizability}} of {{Image-Based Air Quality Models}}},
  booktitle = {2025 {{IEEE}}/{{CVF Winter Conference}} on {{Applications}} of {{Computer Vision Workshops}} ({{WACVW}})},
  author = {Byler, Eleanor and Svinth, Christian and Chojnicki, Kirsten},
  date = {2025-02-28},
  year = {2025},
  pages = {1091--1100},
  publisher = {IEEE},
  location = {Tucson, AZ, USA},
  doi = {10.1109/WACVW65960.2025.00131},
  url = {https://ieeexplore.ieee.org/document/10972624/},
  abstract = {The ability to rapidly quantify atmospheric pollutants is important both for global emissions monitoring and for mitigating the adverse effects that follow a hazardous chemical release. In the aftermath of a chemical release, imagery is often the only available resource to assess local conditions. Recent work has demonstrated initial success in predicting particulate matter pollution from imagery; however, these results are tied to a specific site and do not generalize to new geographic locations. In this work, we seek to understand how easily deep learning models generalize to new locations in the context of image-based air quality assessments, targeting two distinct tasks: (1) broad measures of particulate matter pollution, and (2) the mass of a given chemical released in hazardous plumes. For the latter, we focus on sulfur dioxide, a toxic aerosol and a major component of particulate matter pollution caused by industrial fossil fuel consumption. To develop a model that operates in the widest possible range of environments, we test different training strategies, including the use of new geolocation foundation models. The best performing models achieve {$>$}80\% accuracy when evaluating unseen imagery at sites seen during training, but we find significant drops in performance when evaluating imagery from unseen sites, at best 65\%. Additionally, we present the public release of the National Parks Air Quality Index Dataset, a new mediumsized dataset that pairs imagery with sensor-based air quality measurements at 15 different national parks.},
  eventtitle = {2025 {{IEEE}}/{{CVF Winter Conference}} on {{Applications}} of {{Computer Vision Workshops}} ({{WACVW}})},
  isbn = {979-8-3315-3662-6},
  langid = {english},
}

@inproceedings{chakrabortyCanImageTell2024,
  title = {Can an {{Image Tell}} the {{Tale}}: {{Looking Beyond}} the {{Haze}} to {{Determine PM2}}.5 {{Concentration}}},
  shorttitle = {Can an {{Image Tell}} the {{Tale}}},
  booktitle = {2024 {{International Joint Conference}} on {{Neural Networks}} ({{IJCNN}})},
  author = {Chakraborty, Sagarnil and Palit, Sarbani and Bhandari, Harsh},
  date = {2024-06-30},
  year = {2024},
  pages = {1--8},
  publisher = {IEEE},
  location = {Yokohama, Japan},
  doi = {10.1109/IJCNN60899.2024.10651248},
  url = {https://ieeexplore.ieee.org/document/10651248/},
  abstract = {In the past few decades, due to rapid growth in industrialization, there has been a steady decline of the air quality along with an increase in the concentration of PM2.5. It is well known that a high PM2.5 concentration adversely affects the environment and has hazardous impact on public health. Therefore, it is important to monitor the PM2.5 concentration at geographic locations where air quality monitoring stations are presently unavailable, especially in remote areas. Unfortunately, installation of such monitoring stations requires expensive instruments and constant maintenance. This paper presents a novel, low-cost and portable alternative to such measurement apparatus, where PM2.5 concentration is estimated based on image input obtained from a camera. The novelty of the present work lies in its hitherto unique attempt to capture information regarding PM2.5 content from visibility degradation caused by the pollutant which is further supplemented by important knowledge regarding seasonal and diurnal variation of it. The latter has a crucial role in the prevention of confounding effects arising from the presence of other weather and atmospheric elements. Another important highlight is the use of a full reference image metric as a feature, for which a powerful, dehazing algorithm has been employed. The results obtained are extremely promising, providing a close to accurate estimation of PM2.5 concentration with R2 values far higher than reported in the literature. To summarize, the construction of a unique feature set, together with an appropriate machine learning algorithm, lead to an extremely reliable, stand-alone approach, deployable on a hand-held device such as a mobile and is a very significant contribution indeed of the proposed approach.},
  eventtitle = {2024 {{International Joint Conference}} on {{Neural Networks}} ({{IJCNN}})},
  isbn = {979-8-3503-5931-2},
  langid = {english},
}

@inproceedings{dohaDeepMultiTaskLearning2026,
  title = {Deep {{Multi-Task Learning}} for {{AQI Classification}} and {{PM2}}.5 {{Estimation}} from {{Images}}},
  booktitle = {2026 {{International Conference}} on {{Circuit}}, {{Systems}} and {{Communication}} ({{ICCSC}})},
  author = {Doha, Akdim and Khadija, Marzagui and Toufik, Mzili and Hassan, Silkan},
  date = {2026-07},
  year = {2026},
  pages = {1--7},
  publisher = {IEEE},
  location = {FEZ, Morocco},
  doi = {10.1109/ICCSC71566.2026.11650424},
  url = {https://ieeexplore.ieee.org/document/11650424/},
  abstract = {Air quality monitoring is crucial for environmental protection and public health. We propose a physics-guided deep multi-task learning framework for image-based air quality estimation. The approach combines deep features extracted by a pre-trained ResNet50 with three atmospheric physical descriptors: entropy, contrast, and dark-channel transmission, fused via an attention-based mechanism. A joint multi-task head simultaneously predicts PM2.5 concentration (regression) and AQI category (6-class classification). Evaluated on the Indo-Nepal dataset (12,240 images, stratified 70/10/20 split), the proposed model achieves 95.2\% classification accuracy, F1-score of 0.95, R²=0.912, MAE=31.47 µg/m³, and RMSE=42.63 µg/m³. Ablation studies confirm the independent contribution of each component physics features, attention fusion, and multi-task learning, over four progressive baseline configurations.},
  eventtitle = {2026 {{International Conference}} on {{Circuit}}, {{Systems}} and {{Communication}} ({{ICCSC}})},
  isbn = {979-8-3195-3370-8},
  langid = {english},
}

@article{hanSmartCamAirDetectContrastiveApproach2025,
  title = {{{SmartCamAirDetect}}: {{A Contrastive Approach}} for {{Probabilistic Ambient Air Pollution Estimation With Limited Images}} for {{Smart City Development}}},
  shorttitle = {{{SmartCamAirDetect}}},
  author = {Han, Yang and Li, Victor O. K. and Lam, Jacqueline C. K. and Song, Shiguang and Mo, Tingyu},
  date = {2025},
  year = {2025},
  journaltitle = {IEEE Access},
  shortjournal = {IEEE Access},
  volume = {13},
  pages = {121073--121085},
  issn = {2169-3536},
  doi = {10.1109/ACCESS.2025.3583794},
  url = {https://ieeexplore.ieee.org/document/11053797/},
  abstract = {Effective air pollution monitoring is crucial for data-driven smart city initiatives. However, the sparse distribution of air quality monitoring stations (AQMSs) often results in localized measurements, which may not accurately represent broader air quality conditions. The cost of extensive AQMS expansion is prohibitive, whereas widely distributed stationary cameras offer a cost-effective alternative by providing high-density imagery for ambient air pollution estimation. Nonetheless, cameras distant from AQMSs or newly installed often lack sufficient labeled data, and conventional models trained on limited datasets tend to overfit, leading to substantial estimation errors. To address these challenges, we introduce SmartCamAirDetect, a novel AI-driven contrastive learning framework to enhance air quality estimation performance, tailored to stationary ground-level camera imagery under sparse labeling conditions. Unlike previous contrastive methods developed for satellite-based data, SmartCamAirDetect is specifically designed to handle the fixed scenery and high temporal variability unique to ground-level images. At the core of SmartCamAirDetect is ContraEst, a contrastive learning model that estimates pollution differentials between images and generates probabilistic pollution assessments by comparing a target image from a limited dataset to multiple images captured by other cameras with ample labels. To refine feature extraction, SmartCamAirDetect synthesizes scenery images to eliminate static background features, enabling the model to focus exclusively on pollution-related information such as sky appearance. SmartCamAirDetect is evaluated across various pollutants using multiple performance metrics. Compared to the baseline deterministic model, ContraEst reduces the mean absolute error by 11.61\%, decreases the symmetric mean absolute percentage error by 14.20\%, and improves the Pearson correlation coefficient by 50.97\%. Incorporating synthetic scenery images further reduces the pinball loss and Winkler score for probabilistic estimations by 5.38\% and 5.81\%, respectively. These results underscore the efficacy and robustness of SmartCamAirDetect for image-based air pollution estimation, highlighting its potential for fine-grained, AI-driven air quality monitoring in smart cities. In future work, we aim to improve the interpretability and robustness of the scenery synthesis and removal module under dynamic scenes, enhance contrastive pair selection via optimal sampling strategies, incorporate additional probabilistic baselines to better contextualize uncertainty estimation performance, and strengthen generalizability across diverse urban environments.},
  langid = {english},
}

@article{kambleMobileImageDrivenPM252025,
  title = {A {{Mobile Image-Driven PM2}}.5 {{Estimation Framework Using Deep Learning Techniques}}},
  author = {Kamble, Anupam and Aramkul, Somrawee and Champrasert, Paskorn},
  date = {2025},
  year = {2025},
  journaltitle = {IEEE Access},
  shortjournal = {IEEE Access},
  volume = {13},
  pages = {16196--16207},
  issn = {2169-3536},
  doi = {10.1109/ACCESS.2024.3521966},
  url = {https://ieeexplore.ieee.org/document/10813353/},
  abstract = {Particulate pollution (PM2.5) is an important concern in Asian countries owing to its health hazards. When planning outdoor activities, understanding the PM2.5 concentration measurement is essential. Because of the lower number of government-run Air Quality Monitoring Stations, other options for obtaining location-specific PM2.5 concentration values are sought. This paper proposes using photo image processing to estimate the PM2.5 concentration. This research aims to improve the efficacy and reduce the computational complexity of the PM2.5 concentration estimation process. The proposed Efficient PM2.5 estimation framework uses EfficientNet-B1 and BiLSTM to estimate PM2.5 concentrations. Met-EfficientNet-B1BiLSTM was designed and implemented to incorporate the meteorological features - temperature, wind speed, and humidity to further improve the estimation accuracy. The EfficientNet-B1 neural network is applied in the image feature vector extraction process. EfficientNet-B1, with a resolution of 240×240 pixels, was determined to be the optimal variant of EfficientNet for a small dataset of images needed for the estimation of the PM2.5 concentration value. The BiLSTM was used for the regression of these image features with PM2.5 concentration values to obtain the estimated PM2.5 concentration. A dataset comprising HDR and non-HDR images was explicitly created for this study to compare the types of images that improve the accuracy of PM2.5 concentration estimation and the feature extraction process. The proposed Efficient PM2.5 estimation framework reduces computational complexity and outperforms ResNet-18LSTM by improving the efficacy by 5.75\% in MAE and 11.43\% in SMAPE metrics. The proposed Efficient PM2.5 estimation framework demonstrates that the mobile image can be efficiently used for PM2.5 concentration estimation.},
  langid = {english},
}

@inproceedings{kaushalEvaluationDeepLearning2024,
  title = {Evaluation of {{Deep Learning Approaches}} for {{Air Quality Analysis}} Using an {{Image Dataset}}},
  booktitle = {2024 {{Second International Conference}} on {{Intelligent Cyber Physical Systems}} and {{Internet}} of {{Things}} ({{ICoICI}})},
  author = {Kaushal, Rajanish Kumar and Pandey, Himani and Kalaiarasi, G. and Arya, Sujata and Rawat, Devyani and L, Natrayan},
  date = {2024-08-28},
  year = {2024},
  pages = {1378--1383},
  publisher = {IEEE},
  location = {Coimbatore, India},
  doi = {10.1109/ICoICI62503.2024.10696429},
  url = {https://ieeexplore.ieee.org/document/10696429/},
  abstract = {Air pollution has caused widespread concern, particularly in developing nations such as India and China. Despite the availability of expensive or inaccurate methods such as sensor-based or community network-based approaches, image-based air pollution evaluation still requires significant improvement. In response to this pressing issue, our research develops an accurate Deep Learning (DL) model for estimating air quality from environmental images. We employed Visual Geometry Group 19 (VGG-19) and Residual Network 50 (ResNet-50) as DL models. The air quality dataset was collected from the internet and grouped into three categories: Good, Moderate, and Severe, based on the Particulate Matter (PM) values. Image pre-processing techniques such as resizing and rescaling were used. The DL models were evaluated using accuracy, loss, and time metrics. ResNet-50 was identified as the best model for identifying air quality based on the images. The achieved accuracy level by ResNet-50 is 97.87\%, and it takes 45.02 seconds to analyze the test data count of 90 images. This shows the effectiveness of the ResNet-50 model in air quality prediction.},
  eventtitle = {2024 {{Second International Conference}} on {{Intelligent Cyber Physical Systems}} and {{Internet}} of {{Things}} ({{ICoICI}})},
  isbn = {979-8-3315-4066-1},
  langid = {english},
}

@inproceedings{kumaar.bImageBasedAir2025,
  title = {Image {{Based Air Quality Level Assessment Using MobileNet And ResNet152V2}}},
  booktitle = {2025 5th {{International Conference}} on {{Applied Automation}} and {{Industrial Diagnostics}} ({{ICAAID}})},
  author = {Kumaar.B, Prathik and Deepak, A.Deepak A.},
  date = {2025-11-18},
  year = {2025},
  pages = {1--5},
  publisher = {IEEE},
  location = {Ghardaia, Algeria},
  doi = {10.1109/ICAAID68975.2025.11358145},
  url = {https://ieeexplore.ieee.org/document/11358145/},
  abstract = {Air is a fundamental resource for sustaining life, and maintaining its quality is vital for ensuring the well-being of people and the protection of the natural environment. Rising levels of pollution caused by rapid industrialization, vehicular emissions, and urban development have made air quality assessment a critical scientific and policy concern. In this work, we examine how deep learning techniques can be applied for accurate air quality level classification using image data caputured in various cities . Specifically, We conduct a performance comparison between two leading convolutional neural networks, MobileNetV2 and ResNet152V2. While both achieved notable improvements over traditional methods, MobileNetV2 proved to be the most effective, offering the highest classification accuracy along with better computational efficiency. Its lightweight architecture makes it well-suited for deployment in environments with limited resources and real-time processing requirements. The findings highlight the efficiency of deep learning in advancing air quality monitoring and suggest future improvements through hybrid models such as Inception-ResNet to enhance predictive capability and generalization across diverse environments.},
  eventtitle = {2025 5th {{International Conference}} on {{Applied Automation}} and {{Industrial Diagnostics}} ({{ICAAID}})},
  isbn = {979-8-3315-9217-2},
  langid = {english},
}

@article{leeEnhancingPM25Detection2025,
  title = {Enhancing {{PM}}{\textsubscript{2.5}} {{Detection}} via {{Multispectral Image-Based Double-Channel Ensemble Learning}} for {{Drones}}},
  author = {Lee, Chao-Yang and Moses Manova, Lebaku},
  date = {2025-09-01},
  year = {2025},
  journaltitle = {IEEE Sensors Journal},
  shortjournal = {IEEE Sensors J.},
  volume = {25},
  number = {17},
  pages = {33528--33539},
  issn = {1530-437X, 1558-1748, 2379-9153},
  doi = {10.1109/JSEN.2025.3585177},
  url = {https://ieeexplore.ieee.org/document/11098626/},
  abstract = {Due to the rapid development of modern cities over the past decade, air pollution has been continuously rising. In areas with severe air pollution, it threatens human health and significantly exacerbates climate change, energy, and food production. Air quality monitoring focuses mainly on detecting particulate matter PM2.5 in the air. However, traditional monitoring stations are expensive and can only provide localized data. On the other hand, RGB images captured by drones often struggle to distinguish between PM2.5 and clouds or fog in the sky. Therefore, based on the above reasons, we developed a unique method in this study, named double-channel ensemble learning (DCEL-PM2.5), to be applied to the PM2.5 detection tasks of drones. Unlike traditional deep learning models that use RGB images for PM2.5 detection, the DCEL method utilizes input data from aero multispectral cameras and builds a dual-channel neural network, which processes raw RGB images and multispectral images [near infrared (NIR), red edge (RE), red (R), green (G), and blue (B)]. Each channel independently trains the multispectral and RGB images to extract attention features and mask information, which are fed into the global weighted average pooling (GWAP). The dual-channel GWAP features are concatenated into a total GWAP feature to detect (PM2.5). Compared with other existing methods, the experimental results show that our proposed DCEL-PM2.5 method provides more accurate PM2.5 predictions while maintaining a low parameter count and high frames/s (FPS), making it highly suitable for drone missions.},
  langid = {english},
}

@inproceedings{marzaguiReviewImageQuality2024,
  title = {A {{Review}} on {{Image Quality Assessment}} for {{Air Quality Index Estimation}}},
  booktitle = {2024 11th {{International Conference}} on {{Wireless Networks}} and {{Mobile Communications}} ({{WINCOM}})},
  author = {Marzagui, Khadija and Abdelouahad, Abdelkaher Ait and Dahmouni, Abdellatif and El Maliani, Ahmed Drissi},
  date = {2024-07-23},
  year = {2024},
  pages = {1--6},
  publisher = {IEEE},
  location = {Leeds, United Kingdom},
  doi = {10.1109/WINCOM62286.2024.10656531},
  url = {https://ieeexplore.ieee.org/document/10656531/},
  abstract = {Air pollution poses a significant global challenge stemming from diverse sources such as vehicles, industries, residences, and natural phenomena. This pervasive issue has profound implications for public health, necessitating a comprehensive understanding of the air quality. Air pollution transcends national development levels, and universal sources contribute to its complexity. The limited number of air quality monitoring stations in urban areas underscores the challenge of obtaining real-time data. However, the widespread deployment of surveillance cameras offers a promising avenue for dense and convenient image capture, thereby facilitating effective air quality evaluation. This article an overview of image quality assessment methods applied to air quality indices. It outlines both objective and subjective approaches to image quality assessment, explores research related to air quality evaluation, presents research findings with in-depth analysis, and concludes by summarizing the key points and suggesting avenues for future research.},
  eventtitle = {2024 11th {{International Conference}} on {{Wireless Networks}} and {{Mobile Communications}} ({{WINCOM}})},
  isbn = {979-8-3503-7786-6},
  langid = {english},
}

@inproceedings{mohanDeepLearningBasedPM252025,
  title = {Deep {{Learning-Based PM2}}.5 {{Concentration Estimation Using Convolutional Neural Network}} on {{Environmental Image Data}}},
  booktitle = {2025 6th {{International Conference}} on {{Recent Advances}} in {{Information Technology}} ({{RAIT}})},
  author = {Mohan, Bhuma Chandra and Challa, Naga Raju and Babu, M Lenin and Chaitanya, T. Krishna and Kumar, Ch. V. M. S. N. Pavan and Panguluri, Sumanth Kumar and Lingisetty, Naga Pavan Kumar},
  date = {2025-03-06},
  year = {2025},
  pages = {1--6},
  publisher = {IEEE},
  location = {Dhanbad, India},
  doi = {10.1109/RAIT65068.2025.11089033},
  url = {https://ieeexplore.ieee.org/document/11089033/},
  abstract = {Globalization and rapid progress in technology is leading to the pollution of the environment severely affecting public health and leading to deaths. Air quality in most of the cities at global level are is very poor and countries are taking several measures to ensure that clean air is available to the public. One pollutant that is to be taken care of in this regard is PM2.5 (Particulate Matter 2.5). In general, estimation of PM2.5 from the environment is measured by using sensors deployed at various locations. Atmospheric pollution also affects the quality of the images captured there. In this work, a novel algorithm using deep learning technique is proposed for estimating the PM2.5 level in the environment by using images captured by the cameras. This problem is forecasted as a regression problem. The features are extracted from the selected pre-trained networks and the corresponding PM2.5 values are given to a regressor. The datasets have images and their PM2.5 values collected from three prominent places (Shadipur, ITO, and DTU) in New Delhi, India. Images were captured by webcams and the corresponding PM2.5 values are obtained from the Pollution Control Board. Coefficient of Determination R2 is computed as the performance metric. An R2 value in excess of 0.91 is obtained on all the three datasets. PM2.5 distribution is not uniform, instead it is skewed. Hence, oversampling techniques are used to overcome the under represented samples.},
  eventtitle = {2025 6th {{International Conference}} on {{Recent Advances}} in {{Information Technology}} ({{RAIT}})},
  isbn = {979-8-3315-2480-7},
  langid = {english},
}

@article{nathvaniHereNowEvaluating2023,
  title = {Beyond Here and Now: {{Evaluating}} Pollution Estimation across Space and Time from Street View Images with Deep Learning},
  shorttitle = {Beyond Here and Now},
  author = {Nathvani, Ricky and D., Vishwanath and Clark, Sierra N. and Alli, Abosede S. and Muller, Emily and Coste, Henri and Bennett, James E. and Nimo, James and Moses, Josephine Bedford and Baah, Solomon and Hughes, Allison and Suel, Esra and Metzler, Antje Barbara and Rashid, Theo and Brauer, Michael and Baumgartner, Jill and Owusu, George and Agyei-Mensah, Samuel and Arku, Raphael E. and Ezzati, Majid},
  date = {2023-12},
  year = {2023},
  journaltitle = {Science of The Total Environment},
  shortjournal = {Science of The Total Environment},
  volume = {903},
  pages = {166168},
  issn = {00489697},
  doi = {10.1016/j.scitotenv.2023.166168},
  url = {https://linkinghub.elsevier.com/retrieve/pii/S0048969723047939},
  abstract = {Advances in computer vision, driven by deep learning, allows for the inference of environmental pollution and its potential sources from images. The spatial and temporal generalisability of image-based pollution models is crucial in their real-world application, but is currently understudied, particularly in low-income countries where infrastructure for measuring the complex patterns of pollution is limited and modelling may therefore provide the most utility. We employed convolutional neural networks (CNNs) for two complementary classification models, in both an end-to-end approach and as an interpretable feature extractor (object detection), to estimate spatially and temporally resolved fine particulate matter (PM2.5) and noise levels in Accra, Ghana. Data used for training the models were from a unique dataset of over 1.6 million images collected over 15 months at 145 representative locations across the city, paired with air and noise measurements. Both end-to-end CNN and object-based approaches surpassed null model benchmarks for predicting PM2.5 and noise at single locations, but performance deteriorated when applied to other locations. Model accuracy diminished when tested on images from locations unseen during training, but improved by sampling a greater number of locations during model training, even if the total quantity of data was reduced. The end-to-end models used characteristics of images associated with atmospheric visibility for predicting PM2.5, and specific objects such as vehicles and people for noise. The results demonstrate the potential and challenges of image-based, spatiotemporal air pollution and noise estimation, and that robust, environmental modelling with images requires integration with traditional sensor networks.},
  langid = {english},
}

@inproceedings{razimiIntegratingDeepLearning2024a,
  title = {Integrating {{Deep Learning Features Extraction}} and {{Image Processing}} for {{Visual Pattern Analysis}} in {{Air Quality Index}} ({{AQI}}) {{Classification}}},
  booktitle = {2024 {{IEEE}} 22nd {{Student Conference}} on {{Research}} and {{Development}} ({{SCOReD}})},
  author = {Razimi, Umi Najiah Ahmad and Ali, Azliza Mohd and Osman, Rozianawaty},
  date = {2024-12-19},
  year = {2024},
  pages = {633--638},
  publisher = {IEEE},
  location = {Selangor, Malaysia},
  doi = {10.1109/SCOReD64708.2024.10872648},
  url = {https://ieeexplore.ieee.org/document/10872648/},
  abstract = {This paper presents a hybrid approach that combines deep learning with traditional image processing to identify and classify visual patterns related to air quality index (AQI) levels in digital images. This method integrates the VGG16 model, famous for deep visual feature extraction, with classical image processing techniques such as color and texture analysis. In this study, a set of outdoor image data representing six different AQI categories ranging from “Good” to “Severe” are utilized. The results of the combination of VGG16 features and traditional image processing techniques show an improvement in accuracy and pattern detection ability compared to using only a single method. This finding provides new insights into image-based air quality monitoring. The results of this discovery should encourage a more effective environmental monitoring system as well as facilitate the detection of extreme or abnormal atmospheric conditions.},
  eventtitle = {2024 {{IEEE}} 22nd {{Student Conference}} on {{Research}} and {{Development}} ({{SCOReD}})},
  isbn = {979-8-3315-1007-7},
  langid = {english},
}

@inproceedings{vahdatpourForecastingVisualizingAir2025,
  title = {Forecasting and {{Visualizing Air Quality}} from {{Sky Images}} with {{Vision-Language Models}}},
  booktitle = {2025 {{IEEE}}/{{CVF International Conference}} on {{Computer Vision Workshops}} ({{ICCVW}})},
  author = {Vahdatpour, Mohammad Saleh and Eyvazi, Maryam and Zhang, Yanqing},
  date = {2025-10-19},
  year = {2025},
  pages = {2762--2770},
  publisher = {IEEE},
  location = {Honolulu, HI, USA},
  doi = {10.1109/ICCVW69036.2025.00288},
  url = {https://ieeexplore.ieee.org/document/11375459/},
  abstract = {Air pollution remains a critical threat to public health and environmental sustainability, yet conventional monitoring systems are often constrained by limited spatial coverage and accessibility. This paper proposes an AI-driven agent that predicts ambient air pollution levels from sky images and synthesizes realistic visualizations of pollution scenarios using generative modeling. Our approach combines statistical texture analysis with supervised learning for pollution classification, and leverages vision-language model (VLM)-guided image generation to produce interpretable representations of air quality conditions. The generated visuals simulate varying degrees of pollution, offering a foundation for user-facing interfaces that improve transparency and support informed environmental decision-making. These outputs can be seamlessly integrated into intelligent applications aimed at enhancing situational awareness and encouraging behavioral responses based on real-time forecasts. We validate our method using a dataset of urban sky images and demonstrate its effectiveness in both pollution level estimation and semantically consistent visual synthesis. The system design further incorporates human-centered user experience principles to ensure accessibility, clarity, and public engagement in air quality forecasting. To support scalable and energyefficient deployment, future iterations will incorporate a green CNN architecture enhanced with FPGA-based incremental learning, enabling real-time inference on edge platforms.},
  eventtitle = {2025 {{IEEE}}/{{CVF International Conference}} on {{Computer Vision Workshops}} ({{ICCVW}})},
  isbn = {979-8-3315-8988-2},
  langid = {english},
}

@inproceedings{vermaImagebasedAirPollution2025,
  title = {Image-Based {{Air Pollution Estimation}} Using {{Deep Learning}}},
  booktitle = {2025 {{IEEE}} 7th {{International Conference}} on {{Computing}}, {{Communication}} and {{Automation}} ({{ICCCA}})},
  author = {Verma, Kashish and Sahdev, Girisha and Joshi, Muskan and {Ishika} and Behera, Priyanka},
  date = {2025-11-28},
  year = {2025},
  pages = {1--5},
  publisher = {IEEE},
  location = {Greater Noida, India},
  doi = {10.1109/ICCCA66364.2025.11325373},
  url = {https://ieeexplore.ieee.org/document/11325373/},
  abstract = {Adequate analysis and continuous air pollution monitoring is very important for making effective policies, guiding public health interventions and driving environmental safety initiatives. The impact of air pollution on both environment and public health makes it necessary to have robust and informed approaches. This research specifically targets assessment of air quality, utilizing an extensive image dataset sourced from regions in Nepal and India. To accomplish this, two deep learning models are used: Convolutional Neural Network (CNN) and Long Short-Term Memory (LSTM). These models are chosen for their proven effectiveness in the image analysis tasks, allowing for their applicability to air pollution identification. The study focuses on the relationship between critical factors like training period, model structure, and convergence technique. This is important for gaining a deep understanding of dynamics involved in the development and optimization of these models for accurate air pollution analysis. To further improve the model performance, the study makes use of rigorous statistical tests and utilizes Receiver Operating Characteristic (ROC) curves, providing a complete evaluation framework. A precise comparative analysis is conducted to highlight the distinct performance and the convergence characteristics of CNN and LSTM models. These algorithms gave high testing accuracies of 96.49\% and 85.87\%, respectively. In the context of image analysis for air pollution, this study provides an exploration of strengths and weaknesses in each approach. By presenting a thorough comparison of results, the research contributes valuable insights that can provide directions to future research using deep learning models for air pollution assessment and management.},
  eventtitle = {2025 {{IEEE}} 7th {{International Conference}} on {{Computing}}, {{Communication}} and {{Automation}} ({{ICCCA}})},
  isbn = {979-8-3315-6980-8},
  langid = {english},
}

@article{wangLightweightAirQuality2024,
  title = {A {{Lightweight Air Quality Monitoring Method Based}} on {{Multiscale Dilated Convolutional Neural Network}}},
  author = {Wang, Zhenyu and Yang, Yingdong and Wu, Fucheng},
  date = {2024-12},
  year = {2024},
  journaltitle = {IEEE Transactions on Industrial Informatics},
  shortjournal = {IEEE Trans. Ind. Inf.},
  volume = {20},
  number = {12},
  pages = {14184--14192},
  issn = {1551-3203, 1941-0050},
  doi = {10.1109/TII.2024.3441653},
  url = {https://ieeexplore.ieee.org/document/10649020/},
  abstract = {Air quality monitor is important for both the environment and human health. In recent years, many computer vision-based air quality monitoring methods have been proposed and have achieved good accuracy in specific scenarios. However, current deep-learning-based models’ deployment on mobile devices is impeded due to their excessively large size. To build a lightweight model, we investigate the potential of dilated convolutional kernels, which can effectively increase the receptive field and acquire multiscale information while maintaining model size. Eventually, we propose a novel method termed multiscale dilated network. The network is tailored to the characteristics of the air quality dataset by rearranging the dilate rate of the dilated convolutional kernels to focus on the global and semantically higher level features, thus improving the detection efficiency and accuracy of the model. Our proposed multiscale dilated block also includes a multiscale fusion mechanism that enables the model to extract air quality information at multiple scales simultaneously. Compared to the current state-of-the-art models, the multiscale dilated network integrates three different scales of dilated kernels, which leads to a reduction of 86.7\% of parameters and 88.5\% of floating point operations and achieves a top-1 classification accuracy of 94.2\%. With the proposed model enhancements, we envision a future where mobile phones and IoT edge devices can function as mobile air quality monitoring stations, thereby creating a dynamic and distributed air quality map for air quality protection.},
  langid = {english},
  keywords = {Important},
}

@article{wangPrototypeFeatureRepresentationGuided2026,
  title = {A {{Prototype Feature Representation-Guided Multitask Learning Framework}} for {{Image-Based PM}}{\textsubscript{2.5}} {{Concentration Monitoring}}},
  author = {Wang, Guangcheng and Yang, Jifan and Jiang, Kui and Gu, Ke and Wong, Lai-Kuan and Lin, Weisi and Zhai, Guangtao},
  date = {2026},
  year = {2026},
  journaltitle = {IEEE Transactions on Geoscience and Remote Sensing},
  shortjournal = {IEEE Trans. Geosci. Remote Sensing},
  volume = {64},
  pages = {4109315--4109315},
  issn = {0196-2892, 1558-0644},
  doi = {10.1109/TGRS.2026.3704231},
  url = {https://ieeexplore.ieee.org/document/11573183/},
  abstract = {With rapid industrialization, air pollution has emerged as a critical societal problem. Particulate matter (PM2.5) poses severe threats to public health and ecosystems, making it paramount to establish accurate and scalable monitoring solutions to safeguard the health of humans and animals as well as the ecological environment. While conventional instruments provide precise measurements, their widespread deployment is hindered by high costs and limited coverage. The image-based methods that utilize widely distributed traffic cameras or drones to capture PM2.5-related visual features (e.g., contrast and saturation) offer a promising alternative. However, existing approaches, including both traditional hand-crafted feature-based methods and deep learning-based methods, face challenges in complex environments and suffer from performance limitations due to the long-tailed distribution of pollution data. To this aim, we propose a prototype feature representation-guided multitask learning (PFRML) framework, which integrates classification and regression for PM2.5 concentration estimation. The framework comprises two main components. First, a convolutional neural network (CNN)Transformer ensemble backbone combines CNN’s strength in local spatial feature extraction with Transformer’s capability in modeling global contextual relationships, enabling robust feature representation under complex conditions. Second, a classification-regression multitask paradigm employs prototype learning (effective in few-shot scenarios) to explicitly constructa PM2.5 pollution level representation space (i.e., prototype features), thereby enhancing sparse sample recognition through clustering constraints. Meanwhile, the regression branch implicitly learns continuous concentrations via a multilayer perception while leveraging the prototype features from the classification branch for auxiliary optimization. Experiments conducted on multiple public benchmarks demonstrate that our method achieves superior prediction accuracy and robustness compared to state-of-the-art (SOTA) PM2.5 estimation methods.},
  langid = {english},
  keywords = {Important},
}

@inproceedings{yadavRoadsideTreeImageBased2025,
  title = {Roadside {{Tree Image-Based Air Quality Estimation}} of {{Gurugram City}}, {{Haryana}}, {{India}}},
  booktitle = {2025 3rd {{International Conference}} on {{Communication}}, {{Security}}, and {{Artificial Intelligence}} ({{ICCSAI}})},
  author = {Yadav, Neelam and Singh, Sunil K and Sharma, Dinesh},
  date = {2025-04-04},
  year = {2025},
  pages = {884--888},
  publisher = {IEEE},
  location = {Greater Noida, India},
  doi = {10.1109/ICCSAI64074.2025.11064176},
  url = {https://ieeexplore.ieee.org/document/11064176/},
  abstract = {The wellness of people is at risk due to air pollution, hence accessible and efficient air quality monitoring is required. Even though traditional ground station-based monitoring systems are accurate, they frequently lack wide spatial coverage and are costly. Recent developments in AI and computer vision have made image-based air quality measurement a viable substitute. In order to evaluate outdoor air quality levels, this study suggests a novel method that makes use of roadside tree photos. Through the use of visual indicators from atmospheric conditions and leaf deterioration, we present a novel, non-invasive approach to air pollution measurement. We also introduce the Image Air Quality Index Database (IAQID), a comprehensive dataset gathered over a year to support further studies on image-based air quality estimation. To solve this issue, and we mostly gather excellent outdoor photos of trees on the roadside in high-medium-low traffic areas. We anticipate this database will stimulate more investigation into image-based air quality assessment. Furthermore, we use this database to conduct extensive studies. We examine the variations in the appearance of outdoor photos under various air quality circumstances using various handcrafted features. The study's findings indicate that weather characteristics are far more accurate than traditional handcrafted ones. In addition, the extinction coefficient, which has an accuracy of 68, quantifies the quantity of light that particles attenuate and functions best in environmental conditions.},
  eventtitle = {2025 3rd {{International Conference}} on {{Communication}}, {{Security}}, and {{Artificial Intelligence}} ({{ICCSAI}})},
  isbn = {979-8-3315-3607-7},
  langid = {english},
}

@inproceedings{zhangAirQualityLevel2024,
  title = {Air {{Quality Level Detection Based}} on {{Image Recognition}}},
  booktitle = {2024 13th {{International Conference}} of {{Information}} and {{Communication Technology}} ({{ICTech}})},
  author = {Zhang, Di and Yang, Bin and Liu, Xuedong and Jin, JiXin and Song, ChunMei},
  date = {2024-04-12},
  year = {2024},
  pages = {305--310},
  publisher = {IEEE},
  location = {Xiamen, China},
  doi = {10.1109/ICTech63197.2024.00064},
  url = {https://ieeexplore.ieee.org/document/10900789/},
  abstract = {Traditional air quality detection methods rely too much on high-precision instruments, which are costly and inflexible. In order to solve this problem, this paper proposes an image recognition-based air quality level detection method, which detects the air quality level by acquiring the scene image information to reduce the dependence on instruments and realize the fine-grained air quality level assessment. In this paper, ResNet18 is used as the base model, and the improved residual module and GeLU function are introduced to improve the feature expression ability and nonlinear fitting ability of the model, and finally, the model's attention to the important channel information is enhanced by adding the ParNetAttention attention mechanism. By constructing an air quality image information base and conducting comparative analysis, the experimental results show that the accuracy of the air quality level detection model based on image recognition proposed in this paper is up to 90.65\%, which is 2.86\% and 0.96\% higher than that of the ResNet18 (87.79\%) and ConvNext-Tiny (89.69\%) with excellent performance, and the number of parameters is 21.68\% lower than that of ParNet-Attention, respectively. The number of parameters is reduced by 21.68\% and 67.97\%, which effectively improves the detection accuracy and computational efficiency.},
  eventtitle = {2024 13th {{International Conference}} of {{Information}} and {{Communication Technology}} ({{ICTech}})},
  isbn = {979-8-3503-7625-8},
  langid = {english},
}
